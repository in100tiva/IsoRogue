{
  "name": "isorogue",
  "version": "0.2.0",
  "description": "Roguelike 3D isométrico por turnos — React + TypeScript, entregue como arquivo único",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "lint": "node tools/check-boundaries.mjs",
    "golden": "node tools/gen-golden.mjs",
    "preview:personagem": "node tools/preview-personagem.mjs",
    "preview:goblin": "node tools/preview-personagem.mjs goblin",
    "preview:slime": "node tools/preview-personagem.mjs slime",
    "preview:ogro": "node tools/preview-personagem.mjs ogro",
    "preview:elenco": "node tools/preview-personagem.mjs elenco",
    "check": "npm run lint && npm run typecheck && npm run typecheck:tools && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
